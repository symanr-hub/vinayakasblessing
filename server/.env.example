PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:5173

# Supabase Configuration
# Replace with your actual project URL and Anon key (from Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Service Role Key (strictly kept on backend only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini Configuration
# Obtain your Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# JWT Secret (optional custom fallback if validating token signature independently)
JWT_SECRET=your-jwt-secret

